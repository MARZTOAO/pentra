# Copy this file to ".env" and fill in your own values.
# Find both in Supabase: Project Settings -> API
#
# The anon key is safe to ship inside the app - Row Level Security
# is what protects your data, not the secrecy of this key.
# The service_role key is NOT safe and must never go in here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
